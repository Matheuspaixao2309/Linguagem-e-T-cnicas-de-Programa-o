#include <stdio.h>
#include <stdlib.h>

/* Faça um algoritmo para armazenar a nota
 bimestral de um total de 10 alunos.
 Ao final solicite qual aluno o usuario deseja 
 que a nota seja apresentada. */
 
 int main (int argc, char * argv[]) {
     int vet_notas[10];
     int i, num;
     
     printf("Cadastre as notas dos alunos");
     for (i=0; i<10; i++) scanf("%d", &vet_notas [i]);
     system("cls");
     
     printf("Qual nota deseja ver (N° do aluno)?");
	 scanf("%d" , &num);
	 if (num>=0 && num<10) printf("%d" , vet_notas[num-1]);
	 else printf ("Nota não cadastrada");
	 
	 return 0;
}
